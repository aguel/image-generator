{
  "name": "image-generator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/serve.mjs dev",
    "build": "next build",
    "start": "node scripts/serve.mjs start",
    "lint": "eslint",
    "test": "node --conditions=react-server --experimental-strip-types --test lib/server/*.test.mjs",
    "images:audit": "node --conditions=react-server --experimental-strip-types scripts/image-metadata.mjs",
    "images:clean": "node --conditions=react-server --experimental-strip-types scripts/image-metadata.mjs --clean",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@remotion/player": "4.0.539",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.539",
    "server-only": "0.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
